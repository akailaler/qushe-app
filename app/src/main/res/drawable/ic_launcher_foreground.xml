<?xml version="1.0" encoding="utf-8"?>
<!--
  「取舍」= 一叠照片，正在一张张过：最远那张几乎融进背景，最近那张是实的。

  为什么不是"两张卡"：两张一样大的错开卡片读起来像"复制 / 粘贴"，
  不像"一叠正在被处理的东西"。三张、由淡到实地退开，才有"一叠"的意思。

  为什么没有箭头：旧图标画的是"上箭头 = 删除、下箭头 = 收藏"。
  下滑早就不做收藏了（改成退出整理），那半张图一直在说一件不存在的事。
  卡片本身说的是"结果"——留一张、走一张，比箭头直接。

  包围盒 32..76 × 25..78，对角线 34.4 < 36 ——
  落在自适应图标的安全圆里，圆形 mask 也不会切到。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 最远的一张 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.30"
        android:pathData="M36,25 H47 A4,4 0 0 1 51,29 V48 A4,4 0 0 1 47,52 H36 A4,4 0 0 1 32,48 V29 A4,4 0 0 1 36,25 Z" />
    <!-- 中间那张 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M44,33 H56 A4,4 0 0 1 60,37 V59 A4,4 0 0 1 56,63 H44 A4,4 0 0 1 40,59 V37 A4,4 0 0 1 44,33 Z" />
    <!-- 正在看的那张：实心暖白 -->
    <path
        android:fillColor="#F6F2E9"
        android:pathData="M54,43 H71 A5,5 0 0 1 76,48 V73 A5,5 0 0 1 71,78 H54 A5,5 0 0 1 49,73 V48 A5,5 0 0 1 54,43 Z" />
</vector>
